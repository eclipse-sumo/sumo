<?xml version="1.0" encoding="utf-8"?>
<!--
    CPack-WIX patch file.

    Adds the `SumoExtras` ComponentGroup (defined in cpack_extras.wxs)
    to the top-level installer feature so that the environment-variable
    and file-association components are actually installed.
-->
<CPackWiXPatch>

    <CPackWiXFragment Id="#PRODUCTFEATURE">
        <ComponentGroupRef Id="SumoExtras"/>
        <ComponentGroupRef Id="SumoShortcuts" />
        <Feature Id="SumoConfigContextMenu" Title="Configuration file context menu" Level="2"
                 Description="Add Open with SUMO GUI and Open with Netedit to the .sumocfg context menu."
                 AllowAdvertise="no">
            <ComponentGroupRef Id="SumoContextMenuEntries" />
        </Feature>
    </CPackWiXFragment>

</CPackWiXPatch>
