<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vTypeDistribution id="trainDist">
        <vType id="trainA" vClass="rail" length="45" maxSpeed="8" probability="0.5"/>
        <vType id="trainB" vClass="rail" length="40" maxSpeed="8" probability="0.5"/>
    </vTypeDistribution>
    <routeDistribution id="routeDist">
        <route id="r0" edges="a b c d e" probability="1.0"/>
    </routeDistribution>
    <vehicle id="t0" type="trainDist" route="routeDist" depart="0" departSpeed="max" line="L1"/>
    <vehicle id="t1" type="trainDist" route="routeDist" depart="10" departSpeed="max" line="L1"/>
    <person id="p0" depart="20">
        <ride from="a" to="e" lines="L1"/>
    </person>
</routes>
