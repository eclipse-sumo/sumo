<routes>
    <!-- "stopper" blocks "end" for 60 s, so vehicles queue on the parallel edges a and b; when space frees on "end",
         the blocked leaders of a and b are checked in the same millisecond and the order of these events decides who enters first -->
    <route id="viaA" edges="beg a end"/>
    <route id="viaB" edges="beg b end"/>
    <vehicle id="stopper" depart="0" route="viaB">
        <stop edge="end" duration="60"/>
    </vehicle>
