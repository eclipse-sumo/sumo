<routes>
    <vType id="bus" vClass="bus"/>
    <route id="shared" edges="start end"/>
    <route id="plain" edges="start end"/>
    <vehicle id="named" type="bus" route="shared" depart="0">
        <stop busStop="existing" duration="4"/>
    </vehicle>
    <vehicle id="namedWithoutStops" type="bus" route="shared" depart="50"/>
    <vehicle id="simple" type="bus" route="plain" depart="100"/>
