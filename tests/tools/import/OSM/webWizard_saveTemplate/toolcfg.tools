<configuration>
    <web-socket value="False" type="bool" help="Create a (legacy) websocket instead of running a http server." category="processing"/>
    <remote value="False" type="bool" help="In remote mode, SUMO GUI will not be automatically opened instead a zip file will be generated." category="processing"/>
    <osm-file value="None" type="file" help="use input file from path." category="processing"/>
    <test-output value="None" type="string" help="Run non-interactively on '--osm-file' or '--bbox' and write output to the given directory." category="processing"/>
    <bbox value="None" type="string" help="bounding box to retrieve in geo coordinates west,south,east,north." category="processing"/>
    <output value="None" type="string" help="Write output to the given folder rather than creating a name based on the timestamp" category="processing"/>
    <address value="" type="string" help="Address for the web socket or server." category="processing"/>
    <port value="None" type="int" help="Port for the web socket or server. By default a random port is chosen." category="processing"/>
    <verbose value="False" type="bool" help="tell me what you are doing" category="processing"/>
    <language value="None" type="string" help="Language of the web interface (by default the language of the browser is used)." category="processing"/>
    <begin value="0" type="time" help="Defines the begin time for the scenario." category="processing"/>
    <end value="900" type="time" help="Defines the end time for the scenario." category="processing"/>
    <netconvert-options value="None" type="string" help="additional comma-separated options for netconvert" category="processing"/>
    <demand value="passenger:6f5,bicycle:2f2,pedestrian:4,ship:1f40" type="string" help="Traffic demand definition for non-interactive mode." category="processing"/>
    <poly value="False" type="bool" help="Add polygons (buildings, waterways, etc.) to the scenario." category="processing"/>
    <public-transport value="False" type="bool" help="Import public transport stops and schedules." category="processing"/>
    <pt-modes value="bus,tram,train,subway,light_rail,monorail,trolleybus,minibus,share_taxi,aerialway,ferry" type="string" help="Comma-separated list of public transport modes to import." category="processing"/>
    <car-only value="False" type="bool" help="Only import roads accessible to passenger cars (plus public transport if enabled)." category="processing"/>
    <decal value="False" type="bool" help="Download satellite background images." category="processing"/>
    <tile-zoom value="17" type="int" help="Zoom level for downloaded satellite background images (12-19)." category="processing"/>
    <left-hand value="False" type="bool" help="Assume left-hand traffic." category="processing"/>
    <road-types value="None" type="string" help="JSON dictionary mapping OSM categories to lists of allowed road types." category="processing"/>
    <osm-mirror value="None" type="string" help="Overpass API mirror URL or shortcut to download OSM data from." category="processing"/>
</configuration>
