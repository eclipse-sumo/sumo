# count on one 1 edge and ratios for all outflows
full

# count on one 1 edge and percentages for all outflows
percentage_input

# use a single ratio interval that covers multiple count intervals
span_intervals

# ratios for all outflows but no absolute counts
no_counts

# count on one 1 edge and ratios for all outflows on 2 edge
partial_counts

# count on one 1 edge and ratios for all outflows
mismatch

# generate targets from the passenger connections of an incoming edge
generated_edge

# generate targets for a junction and use explicit ratios at a selected approach
generated_junction
