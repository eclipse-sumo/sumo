<?xml version="1.0" encoding="UTF-8"?>
<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">
    <entryExitDetector id="e3_partial" period="300" file="e3.xml">
        <detEntry lane="e1_0" pos="10.0"/>
        <detEntry lane="e_cut_0" pos="10.0"/>
        <detExit lane="e2_0" pos="60.0"/>
    </entryExitDetector>
    <entryExitDetector id="e3_no_exit" period="300" file="e3.xml">
        <detEntry lane="e1_0" pos="10.0"/>
        <detExit lane="e_cut_0" pos="60.0"/>
    </entryExitDetector>
    <rerouter id="rr_in" edges="e1 e_cut">
        <interval begin="0" end="3600">
            <destProbReroute id="e2" probability="1.0"/>
            <destProbReroute id="e_cut" probability="0.5"/>
        </interval>
    </rerouter>
    <taz id="taz_in" edges="e1 e_cut"/>
    <taz id="taz_out" edges="e_cut"/>
</additional>
