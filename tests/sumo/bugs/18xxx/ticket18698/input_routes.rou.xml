<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- T2 is routed at insertion while T1 still occupies S0, so the free position of S0 lies behind T2 -->
    <trip id="T1" type="subway" depart="0" from="E0" to="E1">
        <stop busStop="S0" duration="10" until="60"/>
        <stop busStop="S1" duration="10"/>
    </trip>
    <trip id="T2" type="subway" depart="30" from="E0" to="E1">
        <stop busStop="S0" duration="10" until="90"/>
        <stop busStop="S1" duration="10"/>
    </trip>
</routes>
