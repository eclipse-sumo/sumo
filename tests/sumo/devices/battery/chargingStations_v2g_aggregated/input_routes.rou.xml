<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <vType accel="1.0" decel="5.0" id="ElectricVehicle" length="5" maxSpeed="100.0" sigma="0.0" minGap="2.5" mass="1600" emissionClass="Energy">
        <param key="device.battery.capacity" value="35000"/>
        <param key="device.battery.maximumChargeRate" value="150000"/>
        <param key="rotatingMass" value="30"/>
        <param key="frontSurfaceArea" value="2.2"/>
        <param key="airDragCoefficient" value="0.33"/>
        <param key="radialDragCoefficient" value="0"/>
        <param key="rollDragCoefficient" value="0.1"/>
        <param key="constantPowerIntake" value="40"/>
        <param key="propulsionEfficiency" value="0.8"/>
        <param key="recuperationEfficiency" value="0.8"/>
    </vType>

    <route id="route01" edges="D2 L2 L12 L10 L7 D7"/>

    <!-- discharging limited by the station (11000 W / 0.9 taken from the battery) until the minimum charge level is reached -->
    <vehicle id="v0" type="ElectricVehicle" depart="0" route="route01">
        <param key="device.battery.chargeLevel" value="13000"/>
        <param key="device.battery.maximumDischargeRate" value="50000"/>
        <param key="device.battery.minimumChargeLevel" value="12950"/>
        <stop chargingStation="CS1" duration="25"/>
    </vehicle>
    <!-- discharging limited by the vehicle (3600 W) -->
    <vehicle id="v1" type="ElectricVehicle" depart="60" route="route01">
        <param key="device.battery.chargeLevel" value="13000"/>
        <param key="device.battery.maximumDischargeRate" value="3600"/>
        <stop chargingStation="CS1" duration="10"/>
    </vehicle>
    <!-- vehicle without discharging is charged as usual -->
    <vehicle id="v2" type="ElectricVehicle" depart="120" route="route01">
        <param key="device.battery.chargeLevel" value="13000"/>
        <stop chargingStation="CS1" duration="10"/>
    </vehicle>
    <!-- vehicle below its minimum charge level is charged up to this level -->
    <vehicle id="v3" type="ElectricVehicle" depart="180" route="route01">
        <param key="device.battery.chargeLevel" value="12000"/>
        <param key="device.battery.maximumDischargeRate" value="50000"/>
        <param key="device.battery.minimumChargeLevel" value="12030"/>
        <stop chargingStation="CS1" duration="10"/>
    </vehicle>
</routes>
