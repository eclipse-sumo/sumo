--no-step-log --no-duration-log --net-file=net.net.xml
-a input_additional.add.xml -r input_routes.rou.xml
--tripinfo-output tripinfos.xml --tripinfo-output.write-unfinished
--stop-output stopinfos.xml --stop-output.write-unfinished
--device.stationfinder.emptyThreshold 0 --device.stationfinder.checkEnergyForRoute false
--device.stationfinder.saturatedChargeLevel 0.22 --chargingstations-output chargingstations.xml
