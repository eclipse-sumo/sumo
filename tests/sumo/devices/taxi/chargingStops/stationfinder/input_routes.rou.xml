<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="taxi" vClass="taxi" emissionClass="Energy">
        <param key="has.taxi.device" value="true"/>
        <param key="has.stationfinder.device" value="true"/>
        <param key="device.battery.capacity" value="35000"/>
        <param key="device.battery.chargeLevel" value="7000"/>
    </vType>

    <!-- the stationfinder plans a charging stop for the taxi which is kept when the taxi is dispatched -->
    <trip id="taxi" type="taxi" depart="0.00" departSpeed="max" from="A0B0" to="B0C0"/>

    <person id="p0" depart="30.00">
        <ride from="B1C1" to="C1D1" lines="taxi"/>
    </person>
    <person id="p1" depart="250.00">
        <ride from="A2B2" to="B2C2" lines="taxi"/>
    </person>
</routes>
