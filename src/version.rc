#include <windows.h>
#include <version.h>
#include <windows-version.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
    FILEVERSION SUMO_WINDOWS_VERSION
    PRODUCTVERSION SUMO_WINDOWS_VERSION
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS VS_FF_DEBUG
#else
    FILEFLAGS 0
#endif
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Eclipse Foundation"
            VALUE "FileDescription", "Eclipse SUMO " SUMO_EXECUTABLE_NAME
            VALUE "FileVersion", SUMO_WINDOWS_VERSION_STRING
            VALUE "InternalName", SUMO_EXECUTABLE_NAME
            VALUE "OriginalFilename", SUMO_EXECUTABLE_NAME ".exe"
            VALUE "ProductName", "Eclipse SUMO"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
